{
  "name": "@theruntimehq/js",
  "version": "0.2.1",
  "description": "Official JavaScript SDK for RuntimeHQ status checking and monitoring.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "runtimehq",
    "status",
    "monitoring",
    "sdk",
    "incident",
    "maintenance"
  ],
  "author": "RuntimeHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRuntimeHQ/runtimehq-js.git"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
